{
  "expo": {
    "name": "Ledger",
    "slug": "daily-ledger",
    "scheme": "ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F1E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ljq471.ledger",
      "infoPlist": {
        "CFBundleDisplayName": "账本"
      }
    },
    "android": {
      "package": "com.ljq471.ledger",
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择账单截图，在本机识别成账目。图片不会上传。",
          "cameraPermission": "拍小票，在本机识别成账目。照片不会上传。"
        }
      ]
    ]
  }
}
